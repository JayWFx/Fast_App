<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="850.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.fast_app.controller.FacturaController">

    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <top>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Label text="Emisión de Factura" style="-fx-font-weight: bold;">
                            <font>
                                <Font size="20.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Fecha:" style="-fx-font-weight: bold;" />
                        <Label fx:id="lblFecha" text="--/--/----" />
                    </children>
                </HBox>
                <Separator />
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10.0" />
            </padding>
            <children>

                <!-- Datos del cliente y factura -->
                <TitledPane animated="false" collapsible="false" text="Información del Cliente">
                    <content>
                        <GridPane hgap="15.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints halignment="RIGHT" minWidth="90.0" prefWidth="110.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="250.0" />
                                <ColumnConstraints halignment="RIGHT" minWidth="80.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="250.0" />
                            </columnConstraints>
                            <children>
                                <Label text="No. Factura:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                <TextField fx:id="txtNumFactura" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Cliente:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                <TextField fx:id="txtCliente" promptText="Nombre del cliente" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="NIT / C.F.:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                <TextField fx:id="txtNit" promptText="NIT o C.F." GridPane.columnIndex="3" GridPane.rowIndex="1" />
                            </children>
                        </GridPane>
                    </content>
                </TitledPane>

                <!-- Selección de Producto -->
                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-border-color: #e9ecef;">
                    <children>
                        <Label text="Producto:" />
                        <ComboBox fx:id="cmbProducto" prefWidth="250.0" promptText="Seleccionar producto" />

                        <Label text="Precio:" />
                        <TextField fx:id="txtPrecioUnitario" editable="false" prefWidth="90.0" promptText="0.00" />

                        <Label text="Cantidad:" />
                        <TextField fx:id="txtCantidad" prefWidth="70.0" text="1" />

                        <Button onAction="#agregarDetalle" text="Agregar" />
                        <Button onAction="#eliminarDetalle" text="Quitar" />
                    </children>
                </HBox>

                <!-- Tabla de Detalle -->
                <TableView fx:id="tblDetalles" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                        <TableColumn fx:id="colProducto" prefWidth="300.0" text="Producto" />
                        <TableColumn fx:id="colCantidad" prefWidth="90.0" text="Cantidad" />
                        <TableColumn fx:id="colPrecioUnitario" prefWidth="120.0" text="Precio Unitario" />
                        <TableColumn fx:id="colSubtotal" prefWidth="140.0" text="Subtotal" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- Resumen de Totales -->
                <HBox alignment="CENTER_RIGHT" spacing="20.0">
                    <children>
                        <VBox alignment="CENTER_RIGHT" spacing="5.0">
                            <children>
                                <HBox spacing="10.0">
                                    <children>
                                        <Label text="Subtotal:" />
                                        <Label fx:id="lblSubtotal" style="-fx-font-weight: bold;" text="$0.00" />
                                    </children>
                                </HBox>
                                <HBox spacing="10.0">
                                    <children>
                                        <Label text="IVA (15%):" />
                                        <Label fx:id="lblImpuesto" style="-fx-font-weight: bold;" text="$0.00" />
                                    </children>
                                </HBox>
                                <HBox spacing="10.0">
                                    <children>
                                        <Label text="Total:" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                                        <Label fx:id="lblTotal" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #0d6efd;" text="$0.00" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Botones de Acción -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button onAction="#guardarFactura" prefWidth="130.0" text="Emitir Factura" />
                        <Button onAction="#cerrar" prefWidth="90.0" text="Cerrar" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </center>
</BorderPane>
