<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="650.0" prefWidth="850.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.fast_app.controller.ProductoController">

    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <children>

                <!-- Formulario estructurado en 3 columnas -->
                <GridPane hgap="15.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="90.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250.0" prefWidth="400.0" />
                        <ColumnConstraints halignment="CENTER" minWidth="180.0" prefWidth="180.0" />
                    </columnConstraints>

                    <children>
                        <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtCodigo" maxWidth="Infinity" promptText="Código único" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtNombre" maxWidth="Infinity" promptText="Nombre del producto" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <ComboBox fx:id="cmbCategoria" maxWidth="Infinity" promptText="Seleccionar categoría" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Precio:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <TextField fx:id="txtPrecio" maxWidth="Infinity" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Existencia:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <TextField fx:id="txtExistencia" maxWidth="Infinity" promptText="0" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                        <CheckBox fx:id="chkActivo" text="Activo" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                        <!-- Sección de Imagen a la derecha -->
                        <VBox alignment="CENTER" spacing="10.0" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.rowSpan="6">
                            <children>
                                <ImageView fx:id="imgProducto" fitHeight="130.0" fitWidth="130.0" pickOnBounds="true" preserveRatio="true" style="-fx-border-color: #cccccc; -fx-background-color: #f4f4f4;" />
                                <Button fx:id="btnImagen" onAction="#seleccionarImagen" text="Seleccionar Imagen" />
                            </children>
                        </VBox>
                    </children>
                </GridPane>

                <!-- Botones de Acción -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button fx:id="btnGuardar" onAction="#guardar" prefWidth="90.0" text="Guardar" />
                        <Button fx:id="btnCerrar" onAction="#cerrar" prefWidth="90.0" text="Cerrar" />
                    </children>
                </HBox>

                <!-- Tabla de Productos -->
                <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                        <TableColumn fx:id="colCategoria" prefWidth="130.0" text="Categoría" />
                        <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
                        <TableColumn fx:id="colExistencia" prefWidth="90.0" text="Existencia" />
                        <TableColumn fx:id="colActivo" prefWidth="80.0" text="Activo" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </children>
        </VBox>
    </center>
</BorderPane>