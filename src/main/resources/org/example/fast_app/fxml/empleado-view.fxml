<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="550.0" prefWidth="750.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.fast_app.controller.EmpleadoController">

    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <center>
        <VBox spacing="15.0" BorderPane.alignment="CENTER">
            <children>
                <GridPane hgap="15.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="120.0" prefWidth="130.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="250.0" />
                        <ColumnConstraints halignment="RIGHT" minWidth="100.0" prefWidth="120.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="180.0" prefWidth="200.0" />
                    </columnConstraints>

                    <children>
                        <Label text="Nombres:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="txtNombres" promptText="Nombres" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Apellidos:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                        <TextField fx:id="txtApellidos" promptText="Apellidos" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                        <Label text="Cargo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <ComboBox fx:id="cmbCargo" maxWidth="Infinity" promptText="Seleccionar cargo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Fecha Contratación:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <DatePicker fx:id="dtpFechaContratacion" maxWidth="Infinity" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                        <Label text="Estado:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <CheckBox fx:id="chkActivo" text="Activo" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    </children>
                </GridPane>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Button fx:id="btnGuardar" onAction="#guardar" prefWidth="90.0" text="Guardar" />
                        <Button fx:id="btnCerrar" onAction="#cerrar" prefWidth="90.0" text="Cerrar" />
                    </children>
                </HBox>

                <TableView fx:id="tblEmpleados" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colNombres" prefWidth="140.0" text="Nombres" />
                        <TableColumn fx:id="colApellidos" prefWidth="140.0" text="Apellidos" />
                        <TableColumn fx:id="colCargo" prefWidth="130.0" text="Cargo" />
                        <TableColumn fx:id="colFechaContratacion" prefWidth="130.0" text="Contratación" />
                        <TableColumn fx:id="colActivo" prefWidth="70.0" text="Activo" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>
